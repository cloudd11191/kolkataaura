<footer>
  <div>AURA Estate Intelligence — Kolkata, India</div>
  <div>Model trained on <span>2,500</span> verified listings</div>
</footer>

<script>
  /* ---------- Background slideshow (crossfade + Ken Burns) ---------- */
  const luxuryImages = [
    "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1600&q=80",
    "https://images.unsplash.com/photo-1742325646212-f917ba1feeaa?auto=format&fit=crop&w=1600&q=80",
    "https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1600&q=80",
    "https://images.unsplash.com/photo-1749834776348-7cf1b8a13e75?auto=format&fit=crop&w=1600&q=80",
    "https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&w=1600&q=80",
    "https://images.unsplash.com/photo-1636560094936-0b87006b6805?auto=format&fit=crop&w=1600&q=80",
    "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1600&q=80"
  ];

  let idx = 0;
  let showingA = true;
  const bgA = document.getElementById("bgA");
  const bgB = document.getElementById("bgB");
  bgA.style.backgroundImage = `url('${luxuryImages[0]}')`;

  function rotateBackground() {
    idx = (idx + 1) % luxuryImages.length;
    const incoming = showingA ? bgB : bgA;
    const outgoing = showingA ? bgA : bgB;
    incoming.style.backgroundImage = `url('${luxuryImages[idx]}')`;
    incoming.classList.add("active");
    outgoing.classList.remove("active");
    showingA = !showingA;
  }
  setInterval(rotateBackground, 5000);

  /* ---------- Clock ---------- */
  function tickClock() {
    const now = new Date();
    const opts = { hour: '2-digit', minute: '2-digit', hour12: false };
    document.getElementById('clock').textContent = now.toLocaleTimeString('en-IN', opts) + ' IST';
  }
  tickClock();
  setInterval(tickClock, 1000 * 30);

  /* ---------- Reveal on scroll ---------- */
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in-view'); });
  }, { threshold: 0.15 });
  document.querySelectorAll('.glass-card').forEach(el => observer.observe(el));

  /* ---------- Locality averages (from 2,500-record training set) ---------- */
  const localityStats = {
    "Alipore": 173.2, "Ballygunge": 164.3, "Bhowanipore": 151.9, "EM Bypass": 116.9,
    "Salt Lake Sector 1": 113.7, "New Alipore": 108.6, "Salt Lake Sector 3": 107.1,
    "Lake Town": 86.5, "Kasba": 85.7, "New Town": 84.7, "Ruby": 84.0,
    "Salt Lake Sector 5": 81.6, "Baguiati": 68.6, "Chinar Park": 67.9, "Jadavpur": 67.5,
    "Tollygunge": 66.9, "Rajarhat": 62.6, "Mukundapur": 60.9, "Dum Dum": 53.0,
    "Narendrapur": 52.5, "Kestopur": 51.4, "Garia": 50.1, "Behala": 48.6,
    "Shambazar": 40.0, "Barasat": 39.8, "Sodepur": 39.4, "Hatibagan": 39.2,
    "Madhyamgram": 38.4, "Howrah": 37.6, "Uttarpara": 37.0, "Sonarpur": 36.0,
    "Serampore": 34.7
  };

  /* ---------- Ticker (built from real locality data) ---------- */
  const tickerTrack = document.getElementById('tickerTrack');
  const tickerEntries = Object.entries(localityStats)
    .sort((a, b) => b[1] - a[1])
    .map(([name, avg]) => `<div class="ticker-item">${name} <b>₹${avg.toFixed(1)}L avg</b> <span class="up">●</span></div>`)
    .join('');
  tickerTrack.innerHTML = tickerEntries + tickerEntries; // duplicate for seamless loop

  /* ---------- Gauge helpers ---------- */
  const CIRC = 2 * Math.PI * 95; // ~597
  const gaugeFill = document.getElementById('gaugeFill');

  function setGauge(fraction) {
    const clamped = Math.max(0, Math.min(1, fraction));
    gaugeFill.style.strokeDashoffset = CIRC - (clamped * CIRC);
  }

  function tierFor(priceLakhs) {
    if (priceLakhs < 50) return { label: "Entry Residence", frac: 0.22 };
    if (priceLakhs < 100) return { label: "Premium Residence", frac: 0.45 };
    if (priceLakhs < 200) return { label: "Elite Residence", frac: 0.72 };
    return { label: "Ultra-Luxury Estate", frac: 0.96 };
  }

  function updateStrategicLens(rawLakhs, locality, area, propertyAgeYears) {
    const localityAvg = localityStats[locality] || 60;
    const deltaPct = ((rawLakhs - localityAvg) / localityAvg) * 100;
    const ppsf = (rawLakhs * 100000) / area;

    const opportunityScore = Math.max(0, Math.min(100, Math.round(52 + deltaPct * 1.3 + (ppsf > 9000 ? 10 : 0))));
    const marketHeat = Math.max(0, Math.min(100, Math.round(45 + (deltaPct > 0 ? deltaPct * 1.6 : -deltaPct * 0.8) + (propertyAgeYears < 5 ? 8 : 0))));
    const riskScore = Math.max(0, Math.min(100, Math.round(68 - opportunityScore * 0.45 + (propertyAgeYears > 15 ? 12 : 0))));

    const opportunityIndexEl = document.getElementById('opportunityIndex');
    const opportunityTextEl = document.getElementById('opportunityText');
    const marketHeatValueEl = document.getElementById('marketHeatValue');
    const marketHeatTextEl = document.getElementById('marketHeatText');
    const investorPlayValueEl = document.getElementById('investorPlayValue');
    const investorPlayTextEl = document.getElementById('investorPlayText');
    const verdictChipEl = document.getElementById('verdictChip');
    const verdictTitleEl = document.getElementById('verdictTitle');
    const verdictTextEl = document.getElementById('verdictText');
    const riskLensValueEl = document.getElementById('riskLensValue');
    const riskLensTextEl = document.getElementById('riskLensText');
    const proj3YEl = document.getElementById('proj3Y');
    const proj5YEl = document.getElementById('proj5Y');
    const proj10YEl = document.getElementById('proj10Y');
    const projectionNarrativeEl = document.getElementById('projectionNarrative');

    const opportunityLabel = opportunityScore >= 75 ? 'Premium upside' : opportunityScore >= 55 ? 'Strong value' : 'Balanced entry';
    const heatLabel = marketHeat >= 75 ? 'Hot demand' : marketHeat >= 55 ? 'Active buyer interest' : 'Measured demand';

    let investorPlay = 'Value play';
    if (opportunityScore >= 75) investorPlay = 'Growth play';
    if (ppsf > 12000) investorPlay = 'Premium play';
    if (deltaPct < -10) investorPlay = 'Value play';

    let verdict = 'Hold';
    let verdictChip = 'Hold';
    if (opportunityScore >= 75 && marketHeat >= 65) { verdict = 'Buy'; verdictChip = 'Buy'; }
    else if (opportunityScore <= 45 || riskScore >= 70) { verdict = 'Sell'; verdictChip = 'Sell'; }

    const growth3Y = rawLakhs * (1 + 0.15);
    const growth5Y = rawLakhs * (1 + 0.32);
    const growth10Y = rawLakhs * (1 + 0.68);

    opportunityIndexEl.textContent = `${opportunityScore}/100`;
    opportunityTextEl.textContent = `${opportunityLabel} • ${locality} is trading ${deltaPct >= 0 ? 'above' : 'below'} its local benchmark by ${Math.abs(deltaPct).toFixed(1)}%.`;

    marketHeatValueEl.textContent = `${marketHeat}/100`;
    marketHeatTextEl.textContent = `${heatLabel} • Price efficiency sits around ₹${Math.round(ppsf).toLocaleString('en-IN')} per sq. ft.`;

    investorPlayValueEl.textContent = investorPlay;
    investorPlayTextEl.textContent = investorPlay === 'Value play'
      ? 'Great for disciplined buying where entry pricing is still below the local premium band.'
      : investorPlay === 'Growth play'
        ? 'Ideal for capital appreciation where infrastructure and demand are moving faster than the city average.'
        : 'Best suited for buyers who want lifestyle-driven premium positioning and long-term prestige value.';

    verdictChipEl.textContent = verdictChip;
    verdictTitleEl.textContent = verdict;
    verdictTextEl.textContent = verdict === 'Buy'
      ? 'The location shows strong upside potential with resilient demand and a favorable investment profile.'
      : verdict === 'Sell'
        ? 'Current pricing appears stretched relative to the area’s fundamentals and may be a weak entry point.'
        : 'The asset is balanced, but timing and local micro-market execution matter before scaling the investment.';

    riskLensValueEl.textContent = `${riskScore}/100`;
    riskLensTextEl.textContent = riskScore < 45
      ? 'Low risk: the asset remains structurally attractive and valuation discipline is healthy.'
      : riskScore < 70
        ? 'Moderate risk: upside remains real, but price and neighbourhood execution should be monitored.'
        : 'High risk: valuation is vulnerable to market softness or weaker local fundamentals.';

    proj3YEl.textContent = `₹${(growth3Y / 100).toFixed(1)}Cr`;
    proj5YEl.textContent = `₹${(growth5Y / 100).toFixed(1)}Cr`;
    proj10YEl.textContent = `₹${(growth10Y / 100).toFixed(1)}Cr`;
    projectionNarrativeEl.textContent = `Projected appreciation based on comparable locality momentum and infrastructure-led demand signals.`;
  }

  /* ---------- Prediction ---------- */
  async function calculatePrice(event) {
    event.preventDefault();

    const priceDisplay = document.getElementById("priceTarget");
    const statusDisplay = document.getElementById("statusTarget");
    const tierLabel = document.getElementById("tierLabel");
    const ppsfTarget = document.getElementById("ppsfTarget");
    const compareTarget = document.getElementById("compareTarget");

    tierLabel.textContent = "Analyzing…";
    priceDisplay.innerHTML = `Computing<small>Running pricing model</small>`;
    statusDisplay.innerHTML = "Cross-referencing the asset profile against comparable Kolkata transactions…";
    setGauge(0.06);

    const locality = document.getElementById("Locality").value;
    const area = floatValueById("Area_SqFt");

    const payload = {
      Locality: locality,
      BHK: parseInt(document.getElementById("BHK").value),
      Area_SqFt: area,
      Bathrooms: parseInt(document.getElementById("Bathrooms").value),
      Furnishing: document.getElementById("Furnishing").value,
      Property_Age_Years: parseInt(document.getElementById("Property_Age_Years").value),
      Gated_Security: checkboxValueById("Gated_Security"),
      Parking_Available: checkboxValueById("Parking_Available"),
      Gymnasium: checkboxValueById("Gymnasium"),
      Swimming_Pool: checkboxValueById("Swimming_Pool"),
      Lift_Available: checkboxValueById("Lift_Available")
    };

    try {
      const response = await fetch('/predict', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const result = await response.json();

      if (response.ok) {
        const rawLakhs = result.predicted_price;
        const tier = tierFor(rawLakhs);

        if (rawLakhs >= 100) {
          priceDisplay.innerHTML = `₹ ${(rawLakhs / 100).toFixed(2)} Cr<small>Estimated Valuation</small>`;
        } else {
          priceDisplay.innerHTML = `₹ ${rawLakhs.toFixed(2)} L<small>Estimated Valuation</small>`;
        }
        tierLabel.textContent = tier.label;
        setGauge(tier.frac);

        const ppsf = (rawLakhs * 100000) / area;
        ppsfTarget.textContent = `₹${Math.round(ppsf).toLocaleString('en-IN')}`;

        const localityAvg = localityStats[locality];
        if (localityAvg) {
          const diff = ((rawLakhs - localityAvg) / localityAvg) * 100;
          const sign = diff >= 0 ? '+' : '';
          compareTarget.textContent = `${sign}${diff.toFixed(1)}%`;
          compareTarget.style.color = diff >= 0 ? 'var(--gold-bright)' : 'var(--sage)';
        } else {
          compareTarget.textContent = '—';
        }

        updateStrategicLens(rawLakhs, locality, area, parseInt(document.getElementById("Property_Age_Years").value));
        statusDisplay.innerHTML = `Valuation certified for <b>${locality}</b> against comparative micro-market indexes.`;
        updateGrowthRadar(locality);
      } else {
        tierLabel.textContent = "Error";
        priceDisplay.innerHTML = `Unavailable<small>Calculation failed</small>`;
        statusDisplay.textContent = `Calculation failure: ${result.error}`;
        setGauge(0);
      }
    } catch (err) {
      tierLabel.textContent = "Connection Refused";
      priceDisplay.innerHTML = `— <small>Backend unreachable</small>`;
      statusDisplay.textContent = "Unable to reach the Flask backend engine. Confirm the server is running.";
      setGauge(0);
    }
  }

  function floatValueById(id) { return parseFloat(document.getElementById(id).value) || 0.0; }
  function checkboxValueById(id) { return document.getElementById(id).checked ? 1 : 0; }
  /* ---------- Growth Radar Handler ---------- */
  async function updateGrowthRadar(locality) {
    const box = document.getElementById("growthRadarBox");
    const headline = document.getElementById("radarHeadline");
    const roi = document.getElementById("radarRoi");
    const list = document.getElementById("radarList");
    const proof = document.getElementById("radarProof");

    try {
      const res = await fetch(`/growth-radar?locality=${encodeURIComponent(locality)}`);
      const data = await res.json();

      if (data.status === "found") {
        const d = data.data;
        headline.textContent = d.catalyst_headline;
        roi.textContent = `Projected ROI Delta: ${d.projected_roi} · ${d.entry_tier}`;
        list.innerHTML = d.detailed_reasons.map(r => `<li>${r}</li>`).join("");
        proof.innerHTML = `Official Proof: <a href="${d.proof_url}" target="_blank" rel="noopener">${d.proof_source} ↗</a>`;
        box.style.display = "flex";
      } else {
        box.style.display = "none";
      }
    } catch (err) {
      box.style.display = "none";
    }
  }

  /* ---------- Populate All 15 Corridors on Load ---------- */
  async function loadCorridorShowcase() {
    const grid = document.getElementById("corridorGrid");
    const revealBtn = document.getElementById("revealAlphaBtn");
    if (!grid) return;

    try {
      const res = await fetch('/growth-radar');
      const result = await res.json();

      if (result.status === "all") {
        grid.innerHTML = Object.entries(result.corridors).map(([name, d]) => `
          <div class="corridor-card">
            <div class="corridor-card-header">
              <div>
                <div class="corridor-card-name">${name}</div>
                <span class="radar-badge" style="font-size: 9px;">${d.entry_tier}</span>
              </div>
              <div class="corridor-card-stats">
                Current Avg: <b>₹${d.current_avg_lakhs.toFixed(1)}L</b><br>
                <span style="color: var(--gold-bright); font-weight: 600;">${d.projected_roi}</span>
              </div>
            </div>
            <div style="font-size: 13.5px; font-weight: 600; color: #FFF; line-height: 1.4;">
              ${d.catalyst_headline}
            </div>
            <ul class="radar-list">
              ${d.detailed_reasons.map(r => `<li>${r}</li>`).join("")}
            </ul>
            <div class="radar-proof">
              Verification: <a href="${d.proof_url}" target="_blank" rel="noopener">${d.proof_source} ↗</a>
            </div>
          </div>
        `).join('');
      }

      if (revealBtn) {
        revealBtn.addEventListener('click', () => {
          const isVisible = grid.classList.contains('visible');

          if (isVisible) {
            grid.classList.remove('visible');
            revealBtn.textContent = 'Reveal Future Alpha';
            revealBtn.classList.remove('is-revealed');
          } else {
            grid.classList.add('visible');
            revealBtn.textContent = 'Hide Alpha';
            revealBtn.classList.add('is-revealed');
          }
        });
      }
    } catch (err) {
      console.error("Failed loading corridors:", err);
    }
  }

  async function forecastFuturePrice() {
    const locality = document.getElementById('Locality').value;
    const box = document.getElementById('forecastBox');
    const status = document.getElementById('forecastStatus');
    const probability = document.getElementById('forecastProbability');
    const headline = document.getElementById('forecastHeadline');
    const growth = document.getElementById('forecastGrowth');
    const avg = document.getElementById('forecastAvg');
    const tier = document.getElementById('forecastTier');
    const drivers = document.getElementById('forecastDrivers');
    const btn = document.getElementById('forecastBtn');
    const confidenceFill = document.getElementById('confidenceFill');
    const confidenceText = document.getElementById('confidenceText');
    const forecastChart = document.getElementById('forecastChart');
    const chartBars = forecastChart ? forecastChart.querySelectorAll('.chart-bar') : [];

    btn.textContent = 'Forecasting...';
    box.style.display = 'block';

    try {
      const response = await fetch(`/future-price-forecast?locality=${encodeURIComponent(locality)}`);
      const data = await response.json();

      if (data && data.status !== 'missing') {
        status.textContent = data.forecast_status;
        probability.textContent = `Probability ${data.probability}%`;
        headline.textContent = `${data.headline} • ${data.summary}`;
        growth.textContent = `${data.expected_growth_pct}%`;
        avg.textContent = data.current_avg_lakhs ? `₹${data.current_avg_lakhs.toFixed(1)}L` : 'N/A';
        tier.textContent = data.entry_tier;
        drivers.innerHTML = (data.drivers || []).map(d => `<li>${d}</li>`).join('') || '<li>Broad urban demand and urban infrastructure momentum.</li>';

        const confidence = Math.max(20, Math.min(95, Number(data.probability) || 50));
        if (confidenceFill) confidenceFill.style.width = `${confidence}%`;
        if (confidenceText) confidenceText.textContent = `${confidence}%`;

        if (chartBars.length) {
          const baseHeights = [22, 38, 56, 76, 100];
          chartBars.forEach((bar, index) => {
            const offset = (confidence - 50) / 2;
            const nextHeight = Math.max(18, Math.min(100, baseHeights[index] + offset));
            bar.style.height = `${nextHeight}%`;
          });
        }
      } else {
        status.textContent = 'Awaiting signal';
        probability.textContent = 'Probability —';
        headline.textContent = 'Select a locality to forecast future price movement.';
        growth.textContent = '—';
        avg.textContent = '—';
        tier.textContent = '—';
        drivers.innerHTML = '<li>Infrastructure and buyer demand are not yet analyzed.</li>';
        if (confidenceFill) confidenceFill.style.width = '0%';
        if (confidenceText) confidenceText.textContent = '0%';
      }
    } catch (err) {
      status.textContent = 'Forecast unavailable';
      probability.textContent = 'Probability —';
      headline.textContent = 'The forecast service could not load. Please retry.';
      growth.textContent = '—';
      avg.textContent = '—';
      tier.textContent = '—';
      drivers.innerHTML = '<li>Data feed unavailable.</li>';
      if (confidenceFill) confidenceFill.style.width = '0%';
      if (confidenceText) confidenceText.textContent = '0%';
    } finally {
      btn.textContent = 'Forecast Future Price';
    }
  }

  function compareLocalities() {
    const a = document.getElementById('compareA').value;
    const b = document.getElementById('compareB').value;
    const result = document.getElementById('compareResult');

    if (a === b) {
      result.innerHTML = 'Choose two different localities to compare strategic opportunity.';
      return;
    }

    const avgA = localityStats[a] || 60;
    const avgB = localityStats[b] || 60;
    const stronger = avgA >= avgB ? a : b;
    const delta = Math.abs(avgA - avgB);
    const p = avgA > avgB ? 'higher' : 'lower';

    result.innerHTML = `
      <strong>${a}</strong> vs <strong>${b}</strong><br>
      ${stronger} is currently priced ${p} in the market, with a spread of about ₹${delta.toFixed(1)}L average value.<br>
      For acceleration-driven capital, <strong>${stronger}</strong> looks stronger on momentum and perceived future premium.<br>
      For value-seeking buyers, the lower-priced market may offer a better entry yield depending on infrastructure timing.
    `;
  }

  function handleChat() {
    const input = document.getElementById('chatInput');
    const chatMessages = document.getElementById('chatMessages');
    const question = input.value.trim();

    if (!question) return;

    const userBubble = document.createElement('div');
    userBubble.className = 'chat-bubble user';
    userBubble.textContent = question;
    chatMessages.appendChild(userBubble);

    const aiBubble = document.createElement('div');
    aiBubble.className = 'chat-bubble ai';

    const q = question.toLowerCase();
    let response = 'AURA suggests you review the locality benchmark, infrastructure signal, and valuation spread before committing to a purchase.';

    if (q.includes('buy') || q.includes('invest')) {
      response = 'The right buy depends on the locality momentum and valuation spread. AURA generally favors markets with strong infrastructure, stable demand, and a price below the premium benchmark.';
    } else if (q.includes('risk') || q.includes('safe')) {
      response = 'Lower risk typically comes from stable local demand, strong transit access, and a valuation not far above the neighbourhood median.';
    } else if (q.includes('new town') || q.includes('barasat') || q.includes('behala') || q.includes('howrah')) {
      response = 'That area has a distinct growth narrative. AURA recommends checking the local price-to-growth ratio, upcoming infrastructure, and comparable transaction quality before decision-making.';
    } else if (q.includes('sell') || q.includes('exit')) {
      response = 'A sell signal usually appears when the asset is materially above the local median with weak upside drivers. AURA checks infrastructure, liquidity, and pricing efficiency.';
    }

    aiBubble.textContent = response;
    chatMessages.appendChild(aiBubble);
    input.value = '';
    chatMessages.scrollTop = chatMessages.scrollHeight;
  }

  document.getElementById('forecastBtn')?.addEventListener('click', forecastFuturePrice);
  document.getElementById('compareBtn')?.addEventListener('click', compareLocalities);
  document.getElementById('chatSendBtn')?.addEventListener('click', handleChat);
  document.getElementById('chatInput')?.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') handleChat();
  });

  window.addEventListener('DOMContentLoaded', loadCorridorShowcase);
</script>
</body>
