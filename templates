  .corridor-grid.visible {
    opacity: 1;
    max-height: 10000px;
    overflow: visible;
    pointer-events: auto;
    transform: translateY(0);
  }
  .corridor-card {
    background: var(--panel);
    backdrop-filter: blur(24px);
    border: 1px solid var(--hairline);
    border-radius: 14px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .corridor-card:hover {
