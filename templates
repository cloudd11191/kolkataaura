  }
  .corridor-card-stats {
    font-family: 'Space Grotesk', monospace;
    font-size: 11px;
    text-align: right;
    color: var(--sage);
  }
  .corridor-card-stats b { color: var(--gold); }
  @media (max-width: 900px) {
    .corridor-section { padding: 0 22px; }
    .corridor-grid { grid-template-columns: 1fr; }
  }
</style>
