  </div>
</header>

<section class="hero">
  <div class="hero-eyebrow">Est. Valuations · City of Joy</div>
  <h1 class="hero-title">Precision valuations for <em>Kolkata's</em> most distinguished addresses</h1>
  <p class="hero-sub">From the colonnades of Alipore to the glass towers of New Town — an intelligence engine trained on 2,500 verified transactions across the city.</p>
  <a href="#valuation" class="hero-cta">
    Begin Valuation
    <svg viewBox="0 0 12 12" fill="none"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.4"/></svg>
  </a>
</section>

<div class="ticker-wrap">
  <div class="ticker-track" id="tickerTrack"></div>
</div>

<main id="valuation">
  <section class="glass-card" id="cardForm">
    <div class="card-eyebrow">Property Parameters</div>
    <h2>Asset Profile</h2>
    <form id="predictionForm" onsubmit="calculatePrice(event)">
      <div class="form-grid">

        <div class="input-group full-width">
          <label>Locality</label>
          <select id="Locality" required>
            <optgroup label="Prestige Enclaves">
              <option value="Alipore">Alipore</option>
              <option value="Ballygunge">Ballygunge</option>
              <option value="Bhowanipore">Bhowanipore</option>
              <option value="New Alipore">New Alipore</option>
              <option value="EM Bypass">EM Bypass</option>
              <option value="Salt Lake Sector 1">Salt Lake Sector 1</option>
              <option value="Salt Lake Sector 3">Salt Lake Sector 3</option>
            </optgroup>
            <optgroup label="Emerging Corridors">
              <option value="Lake Town">Lake Town</option>
              <option value="Kasba">Kasba</option>
              <option value="New Town" selected>New Town</option>
              <option value="Ruby">Ruby</option>
              <option value="Salt Lake Sector 5">Salt Lake Sector 5</option>
              <option value="Baguiati">Baguiati</option>
              <option value="Chinar Park">Chinar Park</option>
              <option value="Jadavpur">Jadavpur</option>
              <option value="Tollygunge">Tollygunge</option>
              <option value="Rajarhat">Rajarhat</option>
              <option value="Mukundapur">Mukundapur</option>
            </optgroup>
            <optgroup label="Established Residential">
              <option value="Dum Dum">Dum Dum</option>
              <option value="Narendrapur">Narendrapur</option>
              <option value="Kestopur">Kestopur</option>
              <option value="Garia">Garia</option>
              <option value="Behala">Behala</option>
            </optgroup>
            <optgroup label="Heritage Suburbs">
              <option value="Shambazar">Shambazar</option>
              <option value="Barasat">Barasat</option>
              <option value="Sodepur">Sodepur</option>
              <option value="Hatibagan">Hatibagan</option>
              <option value="Madhyamgram">Madhyamgram</option>
              <option value="Howrah">Howrah</option>
              <option value="Uttarpara">Uttarpara</option>
              <option value="Sonarpur">Sonarpur</option>
              <option value="Serampore">Serampore</option>
            </optgroup>
          </select>
        </div>

        <div class="input-group">
          <label>Configuration</label>
          <select id="BHK" required>
            <option value="1">1 BHK</option>
            <option value="2" selected>2 BHK</option>
            <option value="3">3 BHK</option>
            <option value="4">4 BHK</option>
          </select>
        </div>

        <div class="input-group">
          <label>Total Area (Sq. Ft.)</label>
          <input type="number" id="Area_SqFt" value="1100" min="300" max="10000" required />
        </div>

        <div class="input-group">
          <label>Bathrooms</label>
          <select id="Bathrooms" required>
            <option value="1">1</option>
            <option value="2" selected>2</option>
            <option value="3">3</option>
            <option value="4">4</option>
          </select>
        </div>

        <div class="input-group">
          <label>Furnishing</label>
          <select id="Furnishing" required>
            <option value="Unfurnished">Unfurnished</option>
            <option value="Semi-Furnished" selected>Semi-Furnished</option>
            <option value="Fully Furnished">Fully Furnished</option>
          </select>
        </div>

        <div class="input-group full-width">
          <label>Property Vintage (Years)</label>
          <input type="number" id="Property_Age_Years" value="2" min="0" max="50" required />
        </div>

        <div class="input-group full-width">
          <label>Premium Amenities</label>
          <div class="amenities-group">
            <label class="checkbox-label"><input type="checkbox" id="Gated_Security" checked> Gated Security</label>
            <label class="checkbox-label"><input type="checkbox" id="Parking_Available" checked> Reserved Parking</label>
            <label class="checkbox-label"><input type="checkbox" id="Gymnasium"> Private Gymnasium</label>
            <label class="checkbox-label"><input type="checkbox" id="Swimming_Pool"> Swimming Pool</label>
            <label class="checkbox-label"><input type="checkbox" id="Lift_Available" checked> High-Speed Elevator</label>
          </div>
        </div>

      </div>
      <button type="submit" class="btn-submit">Compute Asset Value</button>
    </form>
  </section>

  <section class="glass-card dashboard-panel" id="cardDash">
    <div class="card-eyebrow">Real-Time Valuation</div>
    <h2>Intelligence Dashboard</h2>

    <div class="seal">AURA<br>VERITAS</div>

    <div class="gauge-wrap">
      <svg viewBox="0 0 220 220">
        <defs>
          <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#E8C878"/>
            <stop offset="100%" stop-color="#A9812E"/>
          </linearGradient>
        </defs>
        <circle class="gauge-track" cx="110" cy="110" r="95"></circle>
        <circle class="gauge-fill" id="gaugeFill" cx="110" cy="110" r="95"></circle>
      </svg>
      <div class="gauge-center">
        <div class="gauge-tier" id="tierLabel">Awaiting Input</div>
        <div class="gauge-price" id="priceTarget">₹ --<small>Estimated Valuation</small></div>
      </div>
    </div>

    <div class="metrics-row">
      <div class="metric-box">
        <div class="metric-label">Rate / Sq. Ft.</div>
        <div class="metric-value" id="ppsfTarget">—</div>
      </div>
      <div class="metric-box">
        <div class="metric-label">Vs. Locality Avg.</div>
        <div class="metric-value" id="compareTarget">—</div>
      </div>
    </div>

    <div class="status-line" id="statusTarget">Enter the asset's parameters and press <b>Compute Asset Value</b> to run the pricing model.</div>
    <div class="radar-box" id="growthRadarBox" style="display: none;">
      <div class="radar-badge">✦ Infrastructure Growth Signal</div>
      <div class="radar-headline" id="radarHeadline"></div>
      <div class="radar-roi" id="radarRoi"></div>
      <ul class="radar-list" id="radarList"></ul>
      <div class="radar-proof" id="radarProof"></div>
    </div>
  </section>
</main>
<section class="alpha-brief" id="portfolio">
